{
  "name": "fides-sui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -b && pnpm --filter @fides/web typecheck",
    "web": "pnpm --filter @fides/web dev",
    "web:build": "pnpm --filter @fides/web build",
    "web:build:hosted": "pnpm --filter @fides/web build:hosted",
    "web:live": "pnpm --filter @fides/web live",
    "check:secrets": "node scripts/check-secrets.mjs",
    "check:secrets:all": "node scripts/check-secrets.mjs --all",
    "merchants": "tsx apps/merchants/src/run.ts",
    "mockups": "node apps/web/scripts/serve-mockups.mjs",
    "fixtures": "tsx apps/web/scripts/export-fixtures.ts",
    "registry": "tsx apps/registry/src/cli.ts",
    "sim": "tsx apps/sim/src/cli.ts",
    "demo": "tsx apps/agent/src/cli.ts",
    "demo:live": "tsx apps/agent/src/cli.ts --live",
    "demo:rule6": "tsx apps/agent/src/rule6-cli.ts",
    "research": "tsx apps/agent/src/research-cli.ts",
    "trials": "tsx apps/agent/src/trials.ts",
    "day1:mainnet": "node scripts/day1-mainnet.mjs",
    "day1:mainnet:run": "node scripts/day1-mainnet.mjs --yes"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
