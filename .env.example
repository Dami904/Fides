# Names only. Copy to .env and fill in locally. Never commit .env.

# testnet or mainnet. Picks relayer, Tatum gateway and key, Sui network, USDC type (SPEC section 24). Default testnet.
FIDES_NETWORK=
# Required by every agent: the most it may spend in a UTC day, in USDC, for example 5. The engine refuses to start without it.
FIDES_DAILY_CAP_USD=

# Tatum (free plan: 3 requests per second). One key per network; the one for FIDES_NETWORK is used.
TATUM_MAINNET_API_KEY=
TATUM_TESTNET_API_KEY=
TATUM_API_KEY=
TATUM_SUI_RPC_URL=
TATUM_SUI_GRPC_URL=

# Walrus Memory: the shared account and a delegate key per agent (create them at memory.walrus.xyz).
MEMWAL_ACCOUNT_ID=
MEMWAL_KEY_A=
MEMWAL_KEY_B=
# Optional: a key for the registry (defaults to MEMWAL_KEY_A), another namespace than "merchants", a relayer override.
MEMWAL_KEY_REGISTRY=
# Optional, day 1 check 2 only (packages/memory/day1-check2-delegates.mjs): other delegate keys to try.
WEBAPP_DELEGATE_KEY=
WALRUS_PRIVATE_KEY=
FIDES_MEMORY_NAMESPACE=
FIDES_MEMWAL_RELAYER_URL=

# Sui wallet keys (suiprivkey...). packages/evidence/gen-wallets.mjs generates any that are missing. Small test wallets only.
SUI_PRIVATE_KEY_A=
SUI_PRIVATE_KEY_B=
SUI_PRIVATE_KEY_C=
SUI_PRIVATE_KEY_MERCHANTS=
# Path to the Sui CLI, used only to compile the Move package. Default ~/.tools/sui-cli/bin/sui.exe (set it on Linux and macOS).
SUI_CLI=

# State files. Defaults: ./fides-<agent>.sqlite and ./fides-registry.sqlite
FIDES_DB_PATH_A=
FIDES_REGISTRY_DB=

# Services
FIDES_AGENT=
FIDES_MCP_TOKEN=
FIDES_MCP_PORT=
FIDES_MCP_HOST=
FIDES_MCP_ALLOWED_HOSTS=
MERCHANT_ADMIN_TOKEN=
# Set to json for structured logs (one JSON object per line on stderr): payments, claims, reports, retries, rejected evidence.
FIDES_LOG=
FIDES_MERCHANT_SEED=
PORT=
HOST=
TRUST_PROXY=

# Tests. Set to 1 to run the live network tests (need keys and a funded testnet wallet) or the slow simulation tests.
FIDES_LIVE=
FIDES_SLOW=
